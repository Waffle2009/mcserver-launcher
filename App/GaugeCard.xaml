<UserControl x:Class="McServerLauncher.App.GaugeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource StatTile}" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14" HorizontalAlignment="Left" />

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ValueText" Grid.Column="0" Text="--" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

                <Grid Grid.Column="1" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="6" Width="64" Height="64" />
                    <Path x:Name="ArcPath" Stroke="{StaticResource AccentBrush}" StrokeThickness="6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock x:Name="PercentText" Text="--" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BarFillColumn" Width="0*" />
                    <ColumnDefinition x:Name="BarEmptyColumn" Width="100*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="6" CornerRadius="3" Background="{StaticResource NeutralButtonBrush}" />
                <Border x:Name="BarFill" Grid.Column="0" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
