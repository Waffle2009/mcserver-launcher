<Window x:Class="McServerLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McServerLauncher.App"
        Title="かんたんマイクラサーバー" Height="720" Width="1080"
        MinHeight="620" MinWidth="920"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" Effect="{StaticResource ButtonShadow}">
                <Grid Width="14" Height="14">
                    <Rectangle Fill="#FFFFFF" Opacity="0.95" />
                    <Rectangle Fill="{StaticResource AccentPressedBrush}" Width="14" Height="5"
                               VerticalAlignment="Bottom" Opacity="0.55" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="かんたんマイクラサーバー" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="10" VerticalAlignment="Center"
                            Background="{StaticResource NeutralButtonBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="AppVersionText" Text="v0.0.0" FontSize="10.5"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="複数のサーバーをまとめて管理" FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- System resource usage (always visible) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatTile}" Margin="0,0,10,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="CPU使用率" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock x:Name="SystemCpuText" Text="--" Foreground="{StaticResource TextBrush}"
                                   FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="メモリ使用率" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock x:Name="SystemMemoryText" Text="--" Foreground="{StaticResource TextBrush}"
                                   FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="メニュー" Style="{StaticResource SectionTitle}" />

                    <Button Grid.Row="1" x:Name="AddServerButton" Content="+ サーバーを追加" Margin="0,0,0,10"
                            HorizontalAlignment="Stretch" Style="{StaticResource BaseButton}"
                            Click="AddServerButton_Click" />

                    <Border Grid.Row="2" x:Name="OverviewNavItem" Margin="0,0,0,10" Padding="10,9" CornerRadius="9"
                            Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OverviewNavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9638;" FontSize="12" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="概要" Margin="9,0,0,0" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="3" x:Name="ServerListBox"
                             ItemContainerStyle="{StaticResource ServerListItem}"
                             SelectionChanged="ServerListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="{Binding TypeText}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5" FontWeight="SemiBold" Margin="2,10,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="2">
                <!-- Overview dashboard -->
                <ScrollViewer x:Name="OverviewScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="320" />
                        </Grid.RowDefinitions>

                        <!-- Header + bulk actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="概要" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="StartAllButton" Content="すべて起動" Margin="0,0,8,0"
                                        Style="{StaticResource AccentButton}" Click="StartAllButton_Click" />
                                <Button x:Name="RestartAllButton" Content="すべて再起動" Margin="0,0,8,0"
                                        Style="{StaticResource BaseButton}" Click="RestartAllButton_Click" />
                                <Button x:Name="StopAllButton" Content="すべて停止"
                                        Style="{StaticResource DangerButton}" Click="StopAllButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Stat gauges -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:GaugeCard Grid.Column="0" x:Name="SystemCpuGauge" />
                            <local:GaugeCard Grid.Column="2" x:Name="SystemMemGauge" />
                            <local:GaugeCard Grid.Column="4" x:Name="RunningCountGauge" />
                            <local:GaugeCard Grid.Column="6" x:Name="TotalServerCpuGauge" />
                        </Grid>

                        <!-- CPU history -->
                        <local:UsageHistoryChart Grid.Row="2" x:Name="CpuHistoryChart" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid x:Name="ContentPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="380" />
                        </Grid.RowDefinitions>

                        <!-- Status header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="10,5" CornerRadius="20" VerticalAlignment="Center"
                                    Background="{StaticResource NeutralButtonBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Style="{StaticResource StatusDotStyle}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="12"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Stat tiles -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="CPU使用率" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" />
                                    <TextBlock Text="{Binding CpuText}" Foreground="{StaticResource TextBrush}"
                                               FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="メモリ使用量" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" />
                                    <TextBlock Text="{Binding MemoryText}" Foreground="{StaticResource TextBrush}"
                                               FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Server setup card -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="サーバーの準備" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="サーバー種類" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" x:Name="ServerTypeCombo" SelectionChanged="ServerTypeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Paper (Java版)" Tag="Paper" IsSelected="True" />
                                        <ComboBoxItem Content="Spigot (Java版)" Tag="Spigot" />
                                        <ComboBoxItem Content="BDS (統合版)" Tag="Bds" />
                                    </ComboBox>

                                    <TextBlock Grid.Column="3" Text="バージョン" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="4" x:Name="VersionCombo" Margin="0,0,8,0" />
                                    <Button Grid.Column="5" x:Name="RefreshVersionsButton" Content="一覧を取得"
                                            Style="{StaticResource BaseButton}" Click="RefreshVersionsButton_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="インストール先" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" x:Name="InstallDirBox" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" x:Name="BrowseButton" Content="参照..."
                                            Style="{StaticResource BaseButton}" Click="BrowseButton_Click" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" x:Name="EulaCheckBox" Content="Minecraft使用許諾契約(EULA)に同意します" />
                                    <Button Grid.Column="1" x:Name="InstallButton" Content="サーバーを取得(ダウンロード)"
                                            Style="{StaticResource AccentButton}" Click="InstallButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Run card -->
                        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="起動 / 停止" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="メモリ割り当て(MB)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="MemoryBox" Width="90" Text="2048" />
                                    <Button x:Name="StartButton" Content="サーバーを起動" Margin="16,0,0,0"
                                            Style="{StaticResource AccentButton}" Click="StartButton_Click" />
                                    <Button x:Name="StopButton" Content="サーバーを停止" Margin="8,0,0,0"
                                            Style="{StaticResource DangerButton}" Click="StopButton_Click" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Console card -->
                        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="コンソール" Style="{StaticResource SectionTitle}" />

                                <Border Grid.Row="1" Background="{StaticResource LogBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
                                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                                             TextWrapping="NoWrap" Background="Transparent" Foreground="{StaticResource LogTextBrush}"
                                             BorderThickness="0" />
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="CommandBox" Margin="0,0,8,0" KeyDown="CommandBox_KeyDown" />
                                    <Button Grid.Column="1" x:Name="SendCommandButton" Content="送信"
                                            Style="{StaticResource AccentButton}" Click="SendCommandButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
