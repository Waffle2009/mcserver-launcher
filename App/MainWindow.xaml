<Window x:Class="McServerLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="かんたんマイクラサーバー" Height="700" Width="900"
        MinHeight="600" MinWidth="760"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mark -->
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center" Effect="{StaticResource ButtonShadow}">
                <Grid Width="14" Height="14">
                    <Rectangle Fill="#FFFFFF" Opacity="0.95" />
                    <Rectangle Fill="{StaticResource AccentPressedBrush}" Width="14" Height="5"
                               VerticalAlignment="Bottom" Opacity="0.55" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="かんたんマイクラサーバー" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="サーバーの導入から起動・操作までをひとつの画面で" FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Column="2" Padding="10,5" CornerRadius="20" VerticalAlignment="Center"
                    Background="{StaticResource NeutralButtonBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource StatusIdleBrush}" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="停止中" Margin="7,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Server setup card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="サーバーの準備" Style="{StaticResource SectionTitle}" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="サーバー種類" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" x:Name="ServerTypeCombo" SelectionChanged="ServerTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="Paper (Java版)" Tag="Paper" IsSelected="True" />
                        <ComboBoxItem Content="Spigot (Java版)" Tag="Spigot" />
                        <ComboBoxItem Content="BDS (統合版)" Tag="Bds" />
                    </ComboBox>

                    <TextBlock Grid.Column="3" Text="バージョン" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="4" x:Name="VersionCombo" Margin="0,0,8,0" />
                    <Button Grid.Column="5" x:Name="RefreshVersionsButton" Content="一覧を取得"
                            Style="{StaticResource BaseButton}" Click="RefreshVersionsButton_Click" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="インストール先" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" x:Name="InstallDirBox" Margin="0,0,8,0" />
                    <Button Grid.Column="2" x:Name="BrowseButton" Content="参照..."
                            Style="{StaticResource BaseButton}" Click="BrowseButton_Click" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" x:Name="EulaCheckBox" Content="Minecraft使用許諾契約(EULA)に同意します" />
                    <Button Grid.Column="1" x:Name="InstallButton" Content="サーバーを取得(ダウンロード)"
                            Style="{StaticResource AccentButton}" Click="InstallButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Run card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="起動 / 停止" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="メモリ割り当て(MB)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MemoryBox" Width="90" Text="2048" />
                    <Button x:Name="StartButton" Content="サーバーを起動" Margin="16,0,0,0"
                            Style="{StaticResource AccentButton}" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Content="サーバーを停止" Margin="8,0,0,0"
                            Style="{StaticResource DangerButton}" Click="StopButton_Click" IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Console card -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="コンソール" Style="{StaticResource SectionTitle}" />

                <Border Grid.Row="1" Background="{StaticResource LogBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
                    <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                             TextWrapping="NoWrap" Background="Transparent" Foreground="{StaticResource LogTextBrush}"
                             BorderThickness="0" />
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="CommandBox" Margin="0,0,8,0" KeyDown="CommandBox_KeyDown" />
                    <Button Grid.Column="1" x:Name="SendCommandButton" Content="送信"
                            Style="{StaticResource AccentButton}" Click="SendCommandButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
