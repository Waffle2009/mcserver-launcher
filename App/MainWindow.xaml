<Window x:Class="McServerLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McServerLauncher.App"
        Title="かんたんマイクラサーバー" Height="720" Width="1080"
        MinHeight="620" MinWidth="920"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <!-- HUD-style graph-paper backdrop, matches the web dashboard's body background -->
        <Rectangle Fill="{StaticResource GridBackgroundBrush}" IsHitTestVisible="False" />

        <!-- Corner bracket decorations, matches the web dashboard's .hud::before/::after -->
        <Path Data="M0,20 L0,0 L20,0" Stroke="{StaticResource BorderBrush}" StrokeThickness="2"
              Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
              Opacity="0.7" IsHitTestVisible="False" />
        <Path Data="M0,0 L20,0 L20,20" Stroke="{StaticResource BorderBrush}" StrokeThickness="2"
              Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
              Opacity="0.7" IsHitTestVisible="False" />

        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="4" Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center">
                <Grid Width="14" Height="14">
                    <Rectangle Fill="#FFFFFF" Opacity="0.95" />
                    <Rectangle Fill="{StaticResource AccentPressedBrush}" Width="14" Height="5"
                               VerticalAlignment="Bottom" Opacity="0.55" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="かんたんマイクラサーバー" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="3" VerticalAlignment="Center"
                            Background="{StaticResource NeutralButtonBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="AppVersionText" Text="v0.0.0" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="複数のサーバーをまとめて管理" FontSize="11.5"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="メニュー" Style="{StaticResource SectionTitle}" />

                    <Border Grid.Row="1" x:Name="OverviewNavItem" Margin="0,0,0,10" Padding="9,9" CornerRadius="0,3,3,0"
                            Background="{StaticResource CardHoverBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2,0,0,0" Cursor="Hand" MouseLeftButtonUp="OverviewNavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#9638;" FontSize="12" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="概要" Margin="9,0,0,0" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2" x:Name="AddServerButton" Content="+ サーバーを追加" Margin="0,0,0,10"
                            HorizontalAlignment="Stretch" Style="{StaticResource BaseButton}"
                            Click="AddServerButton_Click" />

                    <ListBox Grid.Row="3" x:Name="ServerListBox"
                             ItemContainerStyle="{StaticResource ServerListItem}"
                             SelectionChanged="ServerListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="{Binding TypeText}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5" FontWeight="SemiBold" Margin="2,10,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="2">
                <!-- Overview dashboard -->
                <ScrollViewer x:Name="OverviewScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="320" />
                        </Grid.RowDefinitions>

                        <!-- Header + bulk actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="概要" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="StartAllButton" Content="すべて起動" Margin="0,0,8,0"
                                        Style="{StaticResource StartButtonStyle}" Click="StartAllButton_Click" />
                                <Button x:Name="RestartAllButton" Content="すべて再起動" Margin="0,0,8,0"
                                        Style="{StaticResource RestartButtonStyle}" Click="RestartAllButton_Click" />
                                <Button x:Name="StopAllButton" Content="すべて停止"
                                        Style="{StaticResource DangerButton}" Click="StopAllButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Stat gauges -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:GaugeCard Grid.Column="0" x:Name="SystemCpuGauge" />
                            <local:GaugeCard Grid.Column="2" x:Name="SystemMemGauge" />
                            <local:GaugeCard Grid.Column="4" x:Name="RunningCountGauge" />
                            <local:GaugeCard Grid.Column="6" x:Name="TotalServerCpuGauge" />
                        </Grid>

                        <!-- CPU history -->
                        <local:UsageHistoryChart Grid.Row="2" x:Name="CpuHistoryChart" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid x:Name="ContentPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Status header: name, live stat chips and per-server actions -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="StartButton" Content="起動" Margin="0,0,8,0"
                                                Style="{StaticResource StartButtonStyle}" Click="StartButton_Click" />
                                        <Button x:Name="StopButton" Content="停止" Margin="0,0,8,0"
                                                Style="{StaticResource DangerButton}" Click="StopButton_Click" IsEnabled="False" />
                                        <Button x:Name="RestartButton" Content="再起動" Margin="0,0,8,0"
                                                Style="{StaticResource RestartButtonStyle}" Click="RestartButton_Click" />
                                        <Button x:Name="UpdateButton" Content="更新" Margin="0,0,8,0"
                                                Style="{StaticResource IndigoButtonStyle}" Click="UpdateButton_Click" />
                                        <Button x:Name="DeleteServerButton" Content="削除"
                                                Style="{StaticResource DangerButton}" Click="DeleteServerButton_Click" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Style="{StaticResource StatusDotStyle}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Margin="7,0,0,0" FontSize="12.5" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding StatusText}" />
                                            <Run Text=" ・ " Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="稼働 " Foreground="{StaticResource MutedTextBrush}" /><Run x:Name="HeaderUptimeText" Text="--" />
                                            <Run Text=" ・ " Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="PID " Foreground="{StaticResource MutedTextBrush}" /><Run x:Name="HeaderPidText" Text="--" />
                                            <Run Text=" ・ " Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="ポート " Foreground="{StaticResource MutedTextBrush}" /><Run x:Name="HeaderPortText" Text="--" />
                                            <Run Text=" ・ " Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="v" Foreground="{StaticResource MutedTextBrush}" /><Run x:Name="HeaderVersionText" Text="--" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock FontSize="13" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center">
                                            <Run Text="CPU " Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="{Binding CpuText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        </TextBlock>
                                        <TextBlock Margin="20,0,0,0" FontSize="13" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center">
                                            <Run Text="MEM " Foreground="{StaticResource MutedTextBrush}" />
                                            <Run Text="{Binding MemoryText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tabbed detail view -->
                        <TabControl Grid.Row="1" x:Name="ServerTabs" SelectionChanged="ServerTabs_SelectionChanged">
                            <TabItem Header="コンソール">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="コンソール" Style="{StaticResource SectionTitle}" />

                                        <Border Grid.Row="1" Background="{StaticResource LogBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                            <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                     TextWrapping="NoWrap" Background="Transparent" Foreground="{StaticResource LogTextBrush}"
                                                     BorderThickness="0" />
                                        </Border>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                                <TextBox x:Name="CommandBox" KeyDown="CommandBox_KeyDown" />
                                                <TextBlock Text="コマンドを入力してEnter(例: say hello)" IsHitTestVisible="False"
                                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                                           Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=CommandBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <Button Grid.Column="1" x:Name="SendCommandButton" Content="送信"
                                                    Style="{StaticResource IndigoButtonStyle}" Click="SendCommandButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <TabItem Header="ファイル">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="FilePathText" Text="/" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" x:Name="FileUpButton" Content="上へ" Margin="0,0,8,0"
                                                    Style="{StaticResource BaseButton}" Click="FileUpButton_Click" />
                                            <Button Grid.Column="2" x:Name="OpenInExplorerButton" Content="エクスプローラーで開く"
                                                    Style="{StaticResource BaseButton}" Click="OpenInExplorerButton_Click" />
                                        </Grid>

                                        <ListView Grid.Row="1" x:Name="FileListView" MouseDoubleClick="FileListView_MouseDoubleClick">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="名前" Width="380" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="種類" Width="90" DisplayMemberBinding="{Binding TypeText}" />
                                                    <GridViewColumn Header="サイズ" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="FileDeleteButton" Content="削除" Style="{StaticResource DangerButton}"
                                                    Click="FileDeleteButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <TabItem Header="設定">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="起動設定" Style="{StaticResource SectionTitle}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="メモリ割り当て(MB)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="MemoryBox" Width="90" Text="2048" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Margin="0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="server.properties" Style="{StaticResource SectionTitle}" Margin="0" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button x:Name="ReloadPropertiesButton" Content="再読み込み" Margin="0,0,8,0"
                                                                Style="{StaticResource BaseButton}" Click="ReloadPropertiesButton_Click" />
                                                        <Button x:Name="SavePropertiesButton" Content="保存"
                                                                Style="{StaticResource AccentButton}" Click="SavePropertiesButton_Click" />
                                                    </StackPanel>
                                                </Grid>

                                                <ListView x:Name="PropertiesListView" MaxHeight="320">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="項目" Width="220" DisplayMemberBinding="{Binding Key}" />
                                                            <GridViewColumn Header="値" Width="320">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="権限">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="PermissionNameBox" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" x:Name="AddPermissionButton" Content="OPとして追加"
                                                    Style="{StaticResource AccentButton}" Click="AddPermissionButton_Click" />
                                        </Grid>

                                        <ListView Grid.Row="1" x:Name="PermissionsListView">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="名前 / XUID" Width="280" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="レベル" Width="140" DisplayMemberBinding="{Binding Level}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="RemovePermissionButton" Content="削除" Style="{StaticResource DangerButton}"
                                                    Click="RemovePermissionButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <TabItem Header="バックアップ">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" x:Name="CreateBackupButton" Content="バックアップを作成"
                                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                                Style="{StaticResource AccentButton}" Click="CreateBackupButton_Click" />

                                        <ListView Grid.Row="1" x:Name="BackupsListView">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="名前" Width="260" DisplayMemberBinding="{Binding FileName}" />
                                                    <GridViewColumn Header="作成日時" Width="160" DisplayMemberBinding="{Binding CreatedAtText}" />
                                                    <GridViewColumn Header="サイズ" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="RestoreBackupButton" Content="復元" Margin="0,0,8,0"
                                                    Style="{StaticResource RestartButtonStyle}" Click="RestoreBackupButton_Click" />
                                            <Button x:Name="DeleteBackupButton" Content="削除" Style="{StaticResource DangerButton}"
                                                    Click="DeleteBackupButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <TabItem Header="アドオン">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" x:Name="AddAddonButton" Content="追加..."
                                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                                Style="{StaticResource AccentButton}" Click="AddAddonButton_Click" />

                                        <ListView Grid.Row="1" x:Name="AddonsListView">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="名前" Width="360" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="状態" Width="120" DisplayMemberBinding="{Binding StatusText}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="ToggleAddonButton" Content="有効/無効切替" Margin="0,0,8,0"
                                                    Style="{StaticResource RestartButtonStyle}" Click="ToggleAddonButton_Click" />
                                            <Button x:Name="DeleteAddonButton" Content="削除" Style="{StaticResource DangerButton}"
                                                    Click="DeleteAddonButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <TabItem Header="アクセスログ">
                                <Border Style="{StaticResource CardBorder}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0" x:Name="ClearAccessLogButton" Content="クリア"
                                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                                Style="{StaticResource BaseButton}" Click="ClearAccessLogButton_Click" />

                                        <ListView Grid.Row="1" x:Name="AccessLogListView">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="時刻" Width="140" DisplayMemberBinding="{Binding TimeText}" />
                                                    <GridViewColumn Header="プレイヤー" Width="220" DisplayMemberBinding="{Binding PlayerName}" />
                                                    <GridViewColumn Header="種別" Width="100" DisplayMemberBinding="{Binding EventText}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
