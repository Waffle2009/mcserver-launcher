<Window x:Class="McServerLauncher.App.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サーバーを追加" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="サーバーの種類" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
        <ComboBox Grid.Row="1" x:Name="ServerTypeCombo" Margin="0,0,0,16">
            <ComboBoxItem Content="Paper (Java版)" Tag="Paper" IsSelected="True" />
            <ComboBoxItem Content="Spigot (Java版)" Tag="Spigot" />
            <ComboBoxItem Content="BDS (統合版)" Tag="Bds" />
        </ComboBox>

        <TextBlock Grid.Row="2" Text="サーバー名" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
        <TextBox Grid.Row="3" x:Name="NameBox" Margin="0,0,0,16" />

        <TextBlock Grid.Row="4" Text="マップ" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
        <ComboBox Grid.Row="5" x:Name="MapCombo">
            <ComboBoxItem Content="通常のワールド" Tag="DEFAULT" IsSelected="True" />
            <ComboBoxItem Content="スーパーフラット" Tag="FLAT" />
        </ComboBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Style="{StaticResource BaseButton}" Click="CancelButton_Click"
                    Margin="0,0,8,0" IsCancel="True" />
            <Button Content="追加" Style="{StaticResource StartButtonStyle}" Click="AddButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
