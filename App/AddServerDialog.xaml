<Window x:Class="McServerLauncher.App.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サーバーを追加" Height="180" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="サーバー名" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" x:Name="NameBox" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Style="{StaticResource BaseButton}" Click="CancelButton_Click"
                    Margin="0,0,8,0" IsCancel="True" />
            <Button Content="追加" Style="{StaticResource StartButtonStyle}" Click="AddButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
